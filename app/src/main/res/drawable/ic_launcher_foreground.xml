<?xml version="1.0" encoding="utf-8"?>
<!-- Radar scope motif: outer ring, inner ring, sweep wedge, contact blip.
     Canvas is 108dp; artwork stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring -->
    <path
        android:pathData="M 54,30 a 24,24 0 1,1 -0.01,0 Z"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Inner ring -->
    <path
        android:pathData="M 54,40 a 14,14 0 1,1 -0.01,0 Z"
        android:strokeColor="#8000E5FF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- Sweep wedge (45° sector, up-right) -->
    <path
        android:pathData="M 54,54 L 70.97,37.03 A 24,24 0 0,0 54,30 Z"
        android:fillColor="#4D00E5FF" />

    <!-- Sweep line -->
    <path
        android:pathData="M 54,54 L 70.97,37.03"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Center dot -->
    <path
        android:pathData="M 54,51.5 a 2.5,2.5 0 1,1 -0.01,0 Z"
        android:fillColor="#00E5FF" />

    <!-- Contact blip -->
    <path
        android:pathData="M 63,66 a 3,3 0 1,1 -0.01,0 Z"
        android:fillColor="#FF00FF" />
</vector>
