<?xml version="1.0" encoding="utf-8"?>
<!-- The weather widget at 5 × 1 and wider: current weather, the next 12 hours, then the
     airport and radio rows. Shares view IDs with comsat_widget_weather. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_nordic"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">
    <LinearLayout
        android:id="@+id/widget_weather"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_weather_set_location"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_weather_location" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="@dimen/widget_weather_text_max_width"
                android:text="@string/widget_weather_no_data"
                android:textColor="#D8DEE9"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/widget_weather_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="@dimen/widget_weather_text_max_width"
                android:text="@string/widget_weather_set_location"
                android:textColor="#A8C0D8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- The chart bitmap is drawn at exactly this width, so the hour columns
         line up with its points at 1/8, 3/8, 5/8 and 7/8. -->
    <LinearLayout
        android:id="@+id/widget_forecast"
        android:layout_width="@dimen/widget_forecast_width"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/widget_forecast_chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_forecast_chart_height"
            android:layout_marginBottom="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/widget_forecast_icon_1"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_weather_cloudy" />
                    <TextView
                        android:id="@+id/widget_forecast_temp_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_weather_no_data"
                        android:textColor="#D8DEE9"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_forecast_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#A8C0D8"
                    android:textSize="8.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/widget_forecast_icon_2"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_weather_cloudy" />
                    <TextView
                        android:id="@+id/widget_forecast_temp_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_weather_no_data"
                        android:textColor="#D8DEE9"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_forecast_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#A8C0D8"
                    android:textSize="8.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/widget_forecast_icon_3"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_weather_cloudy" />
                    <TextView
                        android:id="@+id/widget_forecast_temp_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_weather_no_data"
                        android:textColor="#D8DEE9"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_forecast_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#A8C0D8"
                    android:textSize="8.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/widget_forecast_icon_4"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_weather_cloudy" />
                    <TextView
                        android:id="@+id/widget_forecast_temp_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_weather_no_data"
                        android:textColor="#D8DEE9"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_forecast_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#A8C0D8"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/widget_weather_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:background="#4C566A"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/widget_mix"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <include layout="@layout/widget_mix_rows" />
    </LinearLayout>
</LinearLayout>
